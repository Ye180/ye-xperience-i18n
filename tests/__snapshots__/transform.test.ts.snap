"import Link from 'next/link';
import { Badge } from '@/components/Badge';
import { Counter } from '@/components/Counter';
import { useTranslations } from 'next-intl';

export default function HomePage() {
  const t = useTranslations('HomePage');
  return (
    <section>
      <h1>{t('bienvenueChezAtelierLumiere')}</h1>
      <Badge />
      <p>{t('nousFabriquonsDesLampesUniques')}</p>
      <img src="/logo.svg" alt={t('logoDeLAtelier')} width={48} height={48} />
      <button type="button" aria-label={t('ajouterAuxFavoris')}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6" />
        </svg>
        {t('ajouterAuxFavoris')}
      </button>
      {/* i18n-ignore */}
      <p>Ne pas traduire cette ligne.</p>
      <p>
        {t('codePromo')}{' '}<strong>{t('lumiere10')}</strong>
      </p>
      <Link href="/contact">{t('nousContacter')}</Link>
      <Counter />
    </section>
  );
}
"
`;

