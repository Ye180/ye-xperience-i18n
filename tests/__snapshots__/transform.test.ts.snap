"import { useTranslations } from 'next-intl';

export const metadata = { title: 'Contact' };

export default function ContactPage() {
  const t = useTranslations('ContactPage');
  return (
    <form>
      <h1>{t('contactezNous')}</h1>
      <label htmlFor="name">{t('votreNom')}</label>
      <input id="name" name="name" placeholder={t('jeanDupont')} />
      <label htmlFor="email">{t('votreEMail')}</label>
      <input id="email" name="email" type="email" placeholder={t('vousExempleFr')} title={t('adresseEMailValide')} />
      <textarea name="message" placeholder={t('ecrivezVotreMessageIci')} />
      <button type="submit">{t('envoyer')}</button>
    </form>
  );
}
"
`;

